@model List<NTierTodoApp.Models.TaskItem> 
 
<!DOCTYPE html> 
<html> 
<head> 
    <meta charset="utf-8" /> 
    <title>إدارة المهام – n-tier</title> 
</head> 
<body> 
    <h1>قائمة المهام (n-tier)</h1> 
    <ul> 
        @foreach (var task in Model) 
        { 
            <li> 
                @if(task.IsComplete) 
                { 
                    <s>@task.Title</s> 
                } 
                else 
                { 
                    @task.Title 
                    <form method="post" asp-action="CompleteTask" style="display:inline;"> 
                        <input type="hidden" name="id" value="@task.Id" /> 
                        <button type="submit">اكتملت</button> 
                    </form> 
                } 
 

 
                <!-- TODO:  إضافة زر حذف المهمة--> 
                <form method="post" asp-action="Delete" style="display:inline; margin-right: 5px;">
    <input type="hidden" name="id" value="@task.Id"/>
    <button type="submit" style="background-color: #f44336; color: white; border: none; padding: 5px 10px; cursor: pointer;">حذف</button>
            </form> 
            </li> 
        } 
    </ul> 
 
    
</body> 
</html> 
